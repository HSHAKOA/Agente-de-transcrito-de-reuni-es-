.venv/
__pycache__/
*.pyc
.pytest_cache/
*.egg-info/

# transcricoes geradas pelo uso do app (dados do usuario, nao do codigo)
/transcricao*.md
/teste*.md

# reunioes gravadas (audio + estado de sessao) — dados privados do usuario,
# inclui data/meetings.db (Fase E) e data/schedules.json (Fase C.1)
/data/

# pasta de reunioes real escolhida pelo usuario nesta maquina (fica FORA
# de /data/ de proposito, ver settings.py) -- nunca deveria ser commitada
/Eletrica/

# arquivos .md soltos na raiz sao anotacoes pessoais do usuario (workspace
# incidental desta maquina, nao fazem parte do codigo do produto) -- so os
# docs do proprio projeto que vivem na raiz (nao em docs/) sao excecao.
/*.md
!/README.md
!/CHANGELOG.md
!/CONTRIBUTING.md

# transcricao pessoal real sem extensao (mesma anotacao de aula que as
# regras de *.md acima ja cobrem quando salva com extensao) -- ignorada
# pelo nome exato, nao por uma regra generica de "sem extensao": isso
# evitaria esconder por acidente um arquivo-fonte legitimo sem extensao no
# futuro (ex.: LICENSE, Dockerfile). Auditoria pos-missao encontrou este
# arquivo untracked (nunca commitado) escapando da regra acima por nao ter
# ".md" no nome.
/principios da eletricidade240826

# frontend React (Fase F, preview arquitetural) — build artifacts e deps
/frontend/node_modules/
/frontend/dist/
